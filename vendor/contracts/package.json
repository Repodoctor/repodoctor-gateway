{
  "name": "@repodoctor/contracts",
  "version": "0.1.2",
  "description": "Shared versioned TypeScript contracts, events, and API schemas for RepoDoctor.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Repodoctor/repodoctor-contracts.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "repodoctor",
    "contracts"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "cockatiel": "^4.0.0",
    "jose": "^6.2.12",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^9.36.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.44.0",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "vitest": "4.1.11",
    "@vitest/mocker": "4.1.11",
    "@vitest/coverage-v8": "4.1.11"
  }
}
