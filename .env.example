# Copy to .env and fill in local values. Never commit secrets.
# Never put SUPABASE_SERVICE_ROLE_KEY on this service.
# Production auth: AUTH_PROVIDER=supabase plus SUPABASE_URL and SUPABASE_JWKS_URL.
# The dashboard holds the anon/publishable key and signs users in with Supabase.
# The gateway only verifies those JWTs, then mints INTERNAL_SERVICE_TOKEN JWTs
# when calling private APIs (openssl rand -hex 32). Same token on every internal service.
# Coolify: only this service is publicly exposed; others stay on the private network.

NODE_ENV=development
PORT=43111
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=
SUPABASE_URL=
SUPABASE_JWKS_URL=
CORS_ORIGIN=http://127.0.0.1:43120,http://localhost:43120,https://repodoctor.dev,https://repo.slurrpsservers.com
RATE_LIMIT_MAX=200
RATE_LIMIT_WINDOW_MS=60000
SERVICE_NAME=repodoctor-gateway
SERVICE_JWT_TTL_SECONDS=60
INTERNAL_SERVICE_TOKEN=
REPOSITORY_SERVICE_URL=http://127.0.0.1:43113
FINDINGS_SERVICE_URL=http://127.0.0.1:43114
SCM_SERVICE_URL=http://127.0.0.1:43112
GRAPH_SERVICE_URL=http://127.0.0.1:43115
DOCTOR_SERVICE_URL=http://127.0.0.1:43116
CI_DOCTOR_SERVICE_URL=http://127.0.0.1:43117
SECURITY_SERVICE_URL=http://127.0.0.1:43118
DEPENDENCY_SERVICE_URL=http://127.0.0.1:43119
CODE_REVIEW_SERVICE_URL=http://127.0.0.1:43121
DOCUMENTATION_SERVICE_URL=http://127.0.0.1:43122
AI_SERVICE_URL=http://127.0.0.1:43123
REMEDIATION_SERVICE_URL=http://127.0.0.1:43124
ANALYTICS_SERVICE_URL=http://127.0.0.1:43125
AUTH_PROVIDER=local
AUTH_JWT_SECRET=local-dev-only-change-me
# Public GitHub App slug used to build install URLs without calling SCM.
GITHUB_APP_SLUG=repodoctor-app
